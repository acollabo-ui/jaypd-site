$('seek').oninput=e=>seekTo(total*Number(e.target.value)/100);
for(let i=0;i<3;i++)$('track'+i).onclick=()=>{if(segments[i])seekTo(segments[i].start)};
function frame(ms){requestAnimationFrame(frame);if(ms-previous<33)return;previous=ms;const t=now();let index=segments.length?segments.findIndex(s=>t<s.start+s.duration):0;if(index<0)index=2;const segment=segments[index];
 if(index!==activeTrack){activeTrack=index;drawBase(index);$('sampleLabel').textContent='SAMPLE 0'+(index+1)+' / 03';for(let i=0;i<3;i++){const tab=$('track'+i);tab.classList.toggle('active',i===index);tab.setAttribute('aria-current',i===index?'true':'false')}status()}
 const source=customVideo&&video.readyState>=2?video:base;ctx.filter='grayscale(1)';ctx.drawImage(source,0,0,1600,900);ctx.save();ctx.beginPath();ctx.rect(0,0,1600*reveal/100,900);ctx.clip();ctx.filter='none';ctx.drawImage(source,0,0,1600,900);ctx.restore();ctx.filter='none';
 if(!customVideo){const phase=reduced?.22:(segment?(t-segment.start)/segment.duration:t%26/26);ctx.fillStyle='#f3f5e6';ctx.fillRect(222+phase*1090,98,2,630);for(let i=0;i<14;i++){ctx.fillStyle=1582<1600*reveal/100?'#afe68f':'#bfc6b9';ctx.fillRect(1582,109+i*44,6,reduced?8:10+15*Math.abs(Math.sin(t*4+i+index)))}}$('elapsed').textContent=fmt(t);if(total)$('seek').value=String(t/total*100)
}
requestAnimationFrame(frame);prepare().catch(e=>{$('status').textContent='음원 준비 실패. 소리 켜기를 눌러 다시 시도해 주세요.';console.error(e)});
window.addEventListener('pagehide',()=>{stop();if(videoUrl)URL.revokeObjectURL(videoUrl)});

})();
</script>
