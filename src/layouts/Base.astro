---
import { SITE } from '../config';
interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  schema?: object | object[];
}
const { title, description = SITE.description, ogType = 'website', schema } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE.author} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:locale" content="ko_KR" />
  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <style is:global>
    /* jaypd.kr — 좌측 메뉴 + 우측 본문. 색 3개, 장식 없음. */
    :root {
      --ink:        #1A1A1A;
      --ink-soft:   #6B6B6B;
      --paper:      #FFFFFF;
      --amber:      #D98E1F;
      --amber-dark: #B26F0E;
      --rule:       #E5E5E5;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--ink);
      background: var(--paper);
      font-family: Pretendard, -apple-system, sans-serif;
      font-size: 16px;
      line-height: 1.8;
      -webkit-font-smoothing: antialiased;
    }
    .layout { display: flex; max-width: 1000px; margin: 0 auto; gap: 56px; padding: 0 20px; }

    /* 좌측 사이드바 */
    .sidebar {
      width: 200px; flex-shrink: 0;
      position: sticky; top: 0; align-self: flex-start;
      padding: 2.5em 0 2em;
    }
    .sidebar .logo { font-size: 22px; font-weight: 700; color: var(--ink); letter-spacing: -0.02em; }
    .sidebar .logo .dot { color: var(--amber); }
    .sidebar .tagline { margin: 0.4em 0 1.5em; color: var(--ink-soft); font-size: 13px; line-height: 1.6; }
    .sidebar nav a { display: block; color: var(--ink); font-size: 16px; padding: 0.25em 0; }
    .sidebar nav a:hover { color: var(--amber-dark); }
    .sidebar .side-links { margin-top: 2em; padding-top: 1.2em; border-top: 1px solid var(--rule); font-size: 13px; }
    .sidebar .side-links a { display: block; color: var(--ink-soft); padding: 0.15em 0; }
    .sidebar .side-links a:hover { color: var(--amber-dark); }

    /* 우측 본문 */
    main { flex: 1; min-width: 0; max-width: 660px; padding: 2.5em 0 5em; }

    h1 { font-size: 31px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.35; margin: 0 0 0.3em; }
    h2 { font-size: 20px; font-weight: 700; margin: 2.5em 0 0.6em; }
    p { margin: 1.2em 0; }
    a { color: var(--amber); text-decoration: none; }
    a:hover { color: var(--amber-dark); }
    hr { border: 0; border-top: 1px solid var(--rule); margin: 2.5em 0; }
    blockquote { border-left: 2px solid var(--rule); margin: 1.2em 0; padding: 0 0 0 1em; color: var(--ink-soft); }
    article img { max-width: 100%; height: auto; }
    ol, ul { padding-left: 1.4em; }

    .meta { color: var(--ink-soft); font-size: 14px; margin: 0 0 1.5em; }

    .post-line { display: flex; justify-content: space-between; align-items: baseline; gap: 1em; padding: 0.45em 0; }
    .post-line a { font-size: 18px; font-weight: 600; color: var(--ink); }
    .post-line a:hover { color: var(--amber-dark); }
    .post-line time { color: var(--ink-soft); font-size: 14px; white-space: nowrap; }
    .year-label { color: var(--ink-soft); font-size: 14px; margin: 2em 0 0.4em; }

    /* 글 하단 믹스 의뢰 한 줄 (외부 링크) */
    .mix-line { border-top: 1px solid var(--rule); padding-top: 1.5em; margin-top: 3em; }

    .post-nav { display: flex; justify-content: space-between; gap: 1em; margin-top: 1.5em; font-size: 16px; }

    /* 모바일: 사이드바를 상단으로 */

    /* 홈 섹션 그리드 — 디스코그라피(정사각), 블로그 카드, 클럽 사진 */
    .section-label { font-size: 14px; color: var(--ink-soft); margin: 2.5em 0 0.8em; }
    .section-label .label-note { color: #B0B0B0; font-size: 12px; }
    .grid-covers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .cover { position: relative; aspect-ratio: 1; background: #F2F2F2; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
      color: var(--ink-soft); font-size: 13px; text-align: center; }
    .cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    /* 마우스오버 시 이력 캡션이 아래에서 살짝 떠오른다 */
    .cover .cover-caption {
      position: absolute; left: 0; right: 0; bottom: 0; z-index: 1;
      background: rgba(26,26,26,0.82); color: #fff; font-size: 12px; line-height: 1.45;
      text-align: left; padding: 10px 12px; transform: translateY(100%);
      transition: transform .22s ease; }
    .cover:hover .cover-caption, .cover:focus-within .cover-caption { transform: translateY(0); }
    @media (hover: none) { .cover .cover-caption { transform: translateY(0);
      background: rgba(26,26,26,0.6); font-size: 11px; padding: 6px 8px; } }
    .grid-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .card { display: block; color: inherit; }
    .card .thumb { position: relative; aspect-ratio: 16/10; background: #F2F2F2; overflow: hidden;
      display: flex; align-items: center; justify-content: center; color: var(--ink-soft); font-size: 13px; }
    .card .thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .card h3 { font-size: 16px; font-weight: 600; margin: 0.5em 0 0; line-height: 1.5; color: var(--ink); }
    .card:hover h3 { color: var(--amber-dark); }

    /* 블로그 접기/펴기 (네이버 블로그식) */
    details.post-fold { border-bottom: 1px solid var(--rule); padding: 1.2em 0; }
    details.post-fold summary { list-style: none; cursor: pointer; }
    details.post-fold summary::-webkit-details-marker { display: none; }
    details.post-fold summary h2 { font-size: 19px; font-weight: 700; margin: 0; line-height: 1.5; }
    details.post-fold summary .meta { margin: 0.2em 0 0.4em; }
    details.post-fold summary .preview {
      color: var(--ink-soft); margin: 0; font-size: 16px;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    details.post-fold summary .fold-hint { color: var(--amber); font-size: 14px; }
    details.post-fold[open] summary .fold-hint .more { display: none; }
    details.post-fold:not([open]) summary .fold-hint .less { display: none; }
    details.post-fold .fold-body { padding-top: 0.5em; }

    /* 인증클럽 */
    .club-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .club-card { display: block; color: inherit; }
    .club-card .name { font-size: 16px; font-weight: 600; margin-top: 0.4em; color: var(--ink); }
    .club-card .role { font-size: 13px; color: var(--ink-soft); }
    .club-card:hover .name { color: var(--amber-dark); }
    .insta-link { display: inline-block; font-weight: 700; margin-top: 1em; }

    @media (max-width: 768px) {
      .grid-covers, .grid-cards, .club-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 768px) {
      body { font-size: 15px; }
      .layout { flex-direction: column; gap: 0; }
      .sidebar { position: static; width: auto; padding-bottom: 1.2em; border-bottom: 1px solid var(--rule); }
      .sidebar nav a { display: inline-block; margin-right: 1.2em; }
      .sidebar .side-links { display: none; }
      main { padding-top: 1.5em; }
    }
  </style>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <a class="logo" href="/">김승재<span class="dot">.</span></a>
      <p class="tagline">프로듀서 김승재 (Jay)<br />음악이 막힐 때 찾는 16년차 프로듀서</p>
      <nav>
        <a href="/">홈</a>
        <a href="/blog">블로그</a>
        <a href="/review">평론</a>
        <a href="/club">김승재인증클럽</a>
      </nav>
      <div class="side-links">
        <a href="/about">소개</a>
        <a href={SITE.links.youtube}>유튜브 꼰대레코드</a>
        <a href={`mailto:${SITE.email}`}>이메일</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </aside>
    <main><slot /></main>
  </div>
</body>
</html>
