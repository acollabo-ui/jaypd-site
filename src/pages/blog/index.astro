---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toISOString().slice(0, 10);

// 연도별 구분 — 제목·날짜 한 줄, 요약문·썸네일 없음
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
---
<Base title="블로그" description={`${SITE.series} — ${SITE.author}의 글 목록`}>
  <div style="margin-top: 2.5em;">
    <h1>블로그</h1>
    <p class="meta">{SITE.series}</p>
    {[...byYear.entries()].map(([year, yearPosts]) => (
      <>
        <p class="year-label">{year}</p>
        {yearPosts.map((p) => (
          <div class="post-line">
            <a href={`/blog/${p.id}/`}>{p.data.title}</a>
            <time datetime={fmt(p.data.date)}>{fmt(p.data.date)}</time>
          </div>
        ))}
      </>
    ))}
  </div>
</Base>
