---
import Base from '../layouts/Base.astro';
import { SITE, BUSINESS } from '../config';

const albums = [
  { src: '/images/mix/01.jpg', name: '어쿠스틱콜라보', role: '데뷔 · 차트인 8곡 작사·작편곡' },
  { src: '/images/mix/02.jpg', name: '김필선', role: '프로듀싱 · 믹싱', note: '애플뮤직 올해의 음악' },
  { src: '/images/mix/03.jpg', name: '유다빈', role: '프로듀싱 참여' },
  { src: '/images/mix/04.jpg', name: '오시안', role: '프로듀싱 · 믹싱', note: '싱어게인 3 출연' },
  { src: '/images/mix/05.jpg', name: '서자영', role: '프로듀싱', note: '릴스 1,000만 뷰' },
  { src: '/images/mix/06.jpg', name: 'Choyy', role: '프로듀싱 · 믹싱', note: '유튜브뮤직 Daily Top 11' },
  { src: '/images/mix/07.jpg', name: 'Miso', role: '기타 세션', note: '레드불 아티스트' },
  { src: '/images/mix/08.jpg', name: 'DEAN', role: '기타 세션' },
  { src: '/images/mix/09.jpg', name: '새빛', role: '프로듀싱 · 믹싱' },
];

const plans = [
  { type: 'DIRECTION', name: '아티스트 컨설팅', desc: '4P 기반 피드백과 실행 가능한 1년 활동 로드맵', detail: '1:1~4:1 · 온/오프라인 선택', price: '₩200,000', form: 'https://forms.gle/iDdpKm1SETYRgi7QA' },
  { type: 'SOUND', name: '믹스 & 마스터링', desc: '곡의 의도를 살린 발매 가능한 완성본', detail: '1곡', price: '₩400,000', form: 'https://forms.gle/BERfFuNUYUV4zaMt6' },
  { type: 'GROWTH', name: '믹스 + 컨설팅', desc: '좋은 결과물과 다음 곡을 직접 완성할 힘까지', detail: '녹화본 · 교재 · 1년 로드맵', price: '₩500,000', was: '₩600,000', badge: '가장 많이 선택하는 패키지', form: 'https://forms.gle/7k95rNwUkbxRTf2c9', featured: true },
];

const reviews = [
  { body: '하나하나 꼼꼼히 가르쳐주시고 기록해 주시면서, 계단을 오르듯 음악의 깊이와 넓이를 알아갈 수 있었습니다.', who: '신O철 님', service: '믹스 + 컨설팅' },
  { body: '혼자 만들고 믹싱하다 막힐 때 다시 길을 보여주는 강의와 피드백이었습니다. 제작 비용과 퀄리티를 모두 잡을 수 있었습니다.', who: '김O물 님', service: '믹스 + 컨설팅' },
  { body: '예시와 수치를 통해 직관적으로 알려주셔서 이해하며 배울 수 있었습니다. 작업 전 과정을 다시 볼 수 있어서 좋았어요.', who: '아웃ㅇㅇㅇㅇㅇ 님', service: '믹스 + 컨설팅' },
  { body: '곡에 필요한 것을 명확하게 제시하고 만드는 방법까지 알려주셨습니다. 꼼꼼한 피드백으로 유의미한 결과물이 나왔습니다.', who: '코스ㅇㅇㅇ 님', service: '프로듀싱 + 믹스' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: BUSINESS.name,
  description: '프리미엄 믹스 & 마스터링, 1:1~4:1 아티스트 컨설팅.',
  founder: { '@type': 'Person', name: '김승재', jobTitle: '프로듀서 / 믹스 엔지니어' },
  url: SITE.url,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '월드컵로29길 61, 지층 102호',
    addressLocality: '마포구',
    addressRegion: '서울특별시',
    addressCountry: 'KR',
  },
  priceRange: '₩200,000 ~ ₩500,000',
  makesOffer: plans.map((p) => ({ '@type': 'Offer', name: p.name, price: p.price.replace(/[^0-9]/g, ''), priceCurrency: 'KRW' })),
  sameAs: [SITE.links.youtube],
};
---
<Base
  wide
  title="믹스 & 아티스트 컨설팅"
  description="200곡 이상 제작한 16년차 프로듀서 김승재의 믹스 & 마스터링, 1:1~4:1 아티스트 컨설팅."
  schema={serviceSchema}
>
  <div class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">PRODUCER · MIX ENGINEER · ARTIST CONSULTANT</p>
        <h1 id="hero-title">한 곡의 완성,<br /><em>아티스트의 다음까지.</em></h1>
        <p class="hero-lead">당신의 귀가 정답입니다. 16년 동안 아티스트와 믹스 엔지니어, 제작자로 쌓은 경험으로 그 정답을 더 선명하게 만듭니다.</p>
        <div class="actions">
          <a class="button primary" href="#mixing">믹싱 알아보기</a>
          <a class="button ghost" href="#consulting">컨설팅 알아보기</a>
        </div>
        <p class="signature">김승재 Jay · Producer since 2010</p>
      </div>
      <div class="hero-visual">
        <div class="portrait">
          <img src="/images/uploads/jay-profile-half.jpg" alt="흑백 반신 프로필 사진의 프로듀서 김승재" />
          <span>김승재<br />SEOUL, KR</span>
        </div>
        <div class="record" aria-hidden="true"></div>
      </div>
    </section>

    <section class="proof" aria-label="주요 경력">
      <div><strong>16</strong><span>년 제작 경험</span></div>
      <div><strong>200+</strong><span>참여한 곡</span></div>
      <div><strong>20+</strong><span>프로듀싱 아티스트</span></div>
      <div><strong>8</strong><span>차트인 곡</span></div>
    </section>

    <section id="mixing" class="section">
      <header class="section-head">
        <div><p class="eyebrow">01 · MIX & MASTERING</p><h2>당신이 의도한 감정이<br />대중에게 정확히 닿도록.</h2></div>
        <p>크고 깨끗하게 만드는 것만이 믹스의 전부는 아닙니다. 곡의 이야기와 레퍼런스를 먼저 듣고, 아티스트가 선택한 방향을 완성합니다.</p>
      </header>

      <div class="mix-grid">
        <ol class="principles">
          <li><span>01</span><div><strong>의도부터 듣습니다</strong><p>이 곡으로 전하고 싶은 감정을 먼저 확인합니다.</p></div></li>
          <li><span>02</span><div><strong>같은 언어로 맞춥니다</strong><p>레퍼런스와 구체적인 피드백으로 소리를 번역합니다.</p></div></li>
          <li><span>03</span><div><strong>발매까지 완성합니다</strong><p>믹스와 마스터링 완성본을 한 곡 단위로 제공합니다.</p></div></li>
        </ol>

        <div class="player">
          <div class="player-heading">
            <div><p class="eyebrow">REAL MIX SAMPLES</p><h3>같은 구간에서 바로 비교해보세요.</h3></div>
            <span>헤드폰 권장</span>
          </div>
          <div class="sample-btns">
            <button class="sample-btn is-on" data-idx="0"><b>01</b> Sample</button>
            <button class="sample-btn" data-idx="1"><b>02</b> Sample</button>
            <button class="sample-btn" data-idx="2"><b>03</b> Sample</button>
          </div>
          <div class="wave" aria-hidden="true">
            {Array.from({ length: 40 }).map((_, i) => <i style={`--h:${20 + ((i * 19) % 66)}%`}></i>)}
          </div>
          <div class="player-row">
            <button id="playBtn" class="play-btn" aria-label="재생">
              <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
              <svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><path d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
            </button>
            <div class="progress-wrap">
              <div id="progressTrack" class="progress-track" role="slider" tabindex="0" aria-label="재생 위치" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div id="progressFill" class="progress-fill"></div></div>
              <div class="times"><span id="curTime">0:00</span><span id="durTime">0:00</span></div>
            </div>
            <div class="ba-toggle" role="group" aria-label="Before / After 전환">
              <button class="ba-btn is-on" data-mode="before">Before</button>
              <button class="ba-btn" data-mode="after">After</button>
            </div>
          </div>
          <p id="audioStatus" class="audio-status" role="status"></p>
          <a class="sub-link" href="https://youtu.be/rfmFJrLNHy4" target="_blank" rel="noopener">전체 포트폴리오 듣기 ↗</a>
        </div>
      </div>
    </section>

    <section class="work section" aria-labelledby="work-title">
      <header class="section-head compact">
        <div><p class="eyebrow">SELECTED WORK</p><h2 id="work-title">함께 만든 음악들</h2></div>
        <p>어쿠스틱콜라보 데뷔부터<br />애플뮤직 올해의 음악까지.</p>
      </header>
      <div class="albums">
        {albums.map((album, i) => (
          <article class="album">
            <span class="index">{String(i + 1).padStart(2, '0')}</span>
            <img src={album.src} alt={`${album.name} — ${album.role}`} loading="lazy" />
            <div><strong>{album.name}</strong><span>{album.role}</span>{album.note && <em>{album.note}</em>}</div>
          </article>
        ))}
      </div>
    </section>

    <section id="consulting" class="consulting">
      <div class="consulting-copy">
        <p class="eyebrow">02 · ARTIST CONSULTING</p>
        <h2>음악은 만들었는데,<br />다음이 막막하다면.</h2>
        <p>무엇을 만들고, 어떻게 알리고, 어디에 유통하며, 얼마에 만들어야 하는지. 현재를 네 관점으로 진단하고 실행 가능한 1년 로드맵을 만듭니다.</p>
        <a class="button light" href="#pricing">컨설팅 상품 보기</a>
      </div>
      <div class="four-p">
        <div class="you"><strong>YOU</strong><span>지금의 음악과 목표</span></div>
        <div><span>01</span><strong>PRODUCT</strong><p>음악과 캐릭터</p></div>
        <div><span>02</span><strong>PROMOTION</strong><p>콘텐츠와 메시지</p></div>
        <div><span>03</span><strong>PLACE</strong><p>유통</p></div>
        <div><span>04</span><strong>PRICE</strong><p>제작비 산정</p></div>
      </div>
    </section>

    <section id="pricing" class="section">
      <header class="section-head compact">
        <div><p class="eyebrow">CHOOSE YOUR NEXT STEP</p><h2>지금 필요한 만큼 선택하세요.</h2></div>
        <p>신청서를 검토한 뒤 작업 가능 여부와<br />개별 결제 링크를 안내합니다.</p>
      </header>
      <div class="plans">
        {plans.map((plan) => (
          <a class:list={['plan', { featured: plan.featured }]} href={plan.form} target="_blank" rel="noopener">
            {plan.badge && <span class="badge">{plan.badge}</span>}
            <span class="type">{plan.type}</span>
            <strong class="name">{plan.name}</strong>
            <span class="desc">{plan.desc}</span>
            <span class="detail">{plan.detail}</span>
            <span class="plan-bottom"><span>{plan.was && <s>{plan.was}</s>}<b>{plan.price}</b></span><span>신청하기 ↗</span></span>
          </a>
        ))}
      </div>
      <div class="package-note"><b>PACKAGE NOTE</b><p>믹스 + 컨설팅에는 <strong>전 과정 녹화·편집본, 자체 제작 교재, 4P 피드백과 1년 활동 로드맵</strong>이 포함됩니다. 완전 초급자는 신청 전 상담이 필요합니다.</p></div>
    </section>

    <section class="section reviews-section">
      <header class="section-head compact">
        <div><p class="eyebrow">ARTIST NOTES</p><h2>작업 뒤에 남은 이야기</h2></div>
        <p>후기는 과장 없이,<br />실제 작업자의 말로 전합니다.</p>
      </header>
      <div class="reviews">
        {reviews.map((review, i) => (
          <figure class="review">
            <span class="quote">“</span>
            <blockquote>{review.body}</blockquote>
            <figcaption><span>{review.who}</span><em>{review.service}</em><b>{String(i + 1).padStart(2, '0')}</b></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="closing">
      <p class="eyebrow">READY WHEN YOU ARE</p>
      <h2>당신의 음악이 어디까지 갈 수 있는지,<br />한 곡부터 함께 확인해봅시다.</h2>
      <div class="actions"><a class="button primary" href="#pricing">서비스 선택하기</a><a class="sub-link" href="https://youtu.be/BFeeXk0_PR8?si=23k6tSRjX_qhnERE" target="_blank" rel="noopener">신청 전 안내 영상 보기 ↗</a></div>
      <p>컨설팅은 온·오프라인 중 선택할 수 있으며, 1:1부터 4:1까지 진행합니다.</p>
    </section>
  </div>
</Base>

<style>
  .home { --night:#171714; --cream:#f4efe4; }
  .home section { scroll-margin-top:110px; }
  .eyebrow { margin:0 0 1em; color:var(--amber-dark); font-size:11px; font-weight:800; letter-spacing:.16em; line-height:1.4; }
  .hero { min-height:650px; padding:4.5em 0 5em; display:grid; grid-template-columns:1.08fr .92fr; gap:6vw; align-items:center; border-bottom:1px solid var(--rule); }
  .hero h1 { max-width:760px; margin:0; font-size:clamp(42px,5.2vw,76px); line-height:1.08; letter-spacing:-.055em; word-break:keep-all; }
  .hero h1 em { color:var(--amber-dark); font-style:normal; }
  .hero-lead { max-width:600px; margin:2em 0; color:var(--ink-soft); font-size:18px; }
  .actions { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .button { min-height:48px; padding:.72em 1.35em; display:inline-flex; align-items:center; justify-content:center; border:1px solid var(--ink); border-radius:999px; color:var(--ink); font-size:14px; font-weight:700; transition:.18s; }
  .button:hover { transform:translateY(-2px); }
  .primary { background:var(--ink); color:var(--paper); }
  .primary:hover { background:var(--amber); border-color:var(--amber); color:#fff; }
  .ghost:hover { color:var(--amber-dark); border-color:var(--amber); }
  .signature { margin:2.6em 0 0; color:var(--faint); font-size:12px; letter-spacing:.08em; }
  .hero-visual { position:relative; min-height:500px; display:flex; align-items:center; justify-content:center; }
  .portrait { position:relative; z-index:2; width:min(100%,390px); aspect-ratio:4/5; overflow:hidden; background:var(--tile); box-shadow:20px 24px 0 color-mix(in srgb,var(--amber) 22%,transparent); }
  .portrait img { width:100%; height:100%; display:block; object-fit:cover; object-position:58% center; filter:saturate(.78) contrast(1.04); }
  .portrait span { position:absolute; left:18px; bottom:18px; padding:.65em .8em; background:var(--night); color:#fff; font-size:10px; font-weight:700; letter-spacing:.14em; line-height:1.5; }
  .record { position:absolute; right:-8%; bottom:0; width:230px; aspect-ratio:1; border-radius:50%; background:repeating-radial-gradient(circle,#2b2a27 0 2px,#111 3px 7px); box-shadow:0 22px 50px #0003; }
  .record::before { content:''; position:absolute; inset:39%; border:18px solid var(--amber); border-radius:50%; background:var(--paper); }
  .proof { display:grid; grid-template-columns:repeat(4,1fr); border-bottom:1px solid var(--rule); }
  .proof div { padding:2em 1.6em; border-right:1px solid var(--rule); }
  .proof div:first-child { padding-left:0; } .proof div:last-child { border:0; }
  .proof strong { display:block; font-size:30px; line-height:1; letter-spacing:-.04em; } .proof span { color:var(--ink-soft); font-size:12px; }

  .section { padding:7em 0; border-bottom:1px solid var(--rule); }
  .section-head { display:flex; justify-content:space-between; align-items:end; gap:3em; margin-bottom:3.2em; }
  .section-head > div { max-width:760px; }
  .section-head h2,.consulting h2,.closing h2 { margin:0; font-size:clamp(34px,4vw,56px); line-height:1.18; letter-spacing:-.045em; word-break:keep-all; }
  .section-head > p { max-width:380px; margin:0; color:var(--ink-soft); font-size:15px; text-align:right; }
  .mix-grid { display:grid; grid-template-columns:.78fr 1.22fr; gap:28px; }
  .principles { margin:0; padding:1.4em 2em; list-style:none; border:1px solid var(--rule); }
  .principles li { padding:1.2em 0; display:grid; grid-template-columns:34px 1fr; gap:12px; border-bottom:1px solid var(--rule); }
  .principles li:last-child { border:0; } .principles li>span { color:var(--amber-dark); font-size:11px; font-weight:800; }
  .principles strong { font-size:15px; } .principles p { margin:.3em 0 0; color:var(--ink-soft); font-size:13px; line-height:1.65; }

  .player { padding:2.2em; background:var(--night); color:#f7f3e9; border-radius:4px; }
  .player .eyebrow { color:var(--amber); } .player-heading { display:flex; justify-content:space-between; align-items:start; gap:1em; }
  .player-heading h3 { margin:0; font-size:22px; } .player-heading>span { color:#aaa69e; font-size:11px; white-space:nowrap; }
  .sample-btns { margin:2em 0 1.2em; display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
  .sample-btn { padding:.7em; border:1px solid #3d3b36; background:none; color:#aaa69e; border-radius:3px; cursor:pointer; font:inherit; font-size:12px; }
  .sample-btn b { color:var(--amber); margin-right:.3em; } .sample-btn.is-on { background:#f4efe4; border-color:#f4efe4; color:#171714; }
  .wave { height:100px; display:flex; align-items:center; gap:3px; overflow:hidden; opacity:.8; }
  .wave i { flex:1; min-width:2px; height:var(--h); background:#f4efe4; border-radius:2px; }
  .player-row { margin-top:1.5em; display:flex; align-items:center; gap:14px; }
  .play-btn { width:48px; height:48px; flex:none; display:grid; place-items:center; border:0; border-radius:50%; background:var(--amber); color:#171714; cursor:pointer; }
  .play-btn svg[hidden] { display:none; } .progress-wrap { flex:1; min-width:0; }
  .progress-track { height:5px; overflow:hidden; background:#3d3b36; cursor:pointer; border-radius:99px; }
  .progress-track:focus-visible { outline:2px solid var(--amber); outline-offset:4px; } .progress-fill { width:0; height:100%; background:var(--amber); }
  .times { margin-top:5px; display:flex; justify-content:space-between; color:#88847b; font-size:11px; }
  .ba-toggle { display:grid; grid-template-columns:1fr 1fr; border:1px solid #47443e; border-radius:99px; overflow:hidden; }
  .ba-btn { padding:.45em .85em; border:0; background:none; color:#aaa69e; cursor:pointer; font:inherit; font-size:12px; }
  .ba-btn.is-on { background:#f4efe4; color:#171714; } .audio-status { margin:.5em 0 0; color:#aaa69e; font-size:12px; }
  .audio-status:empty { display:none; } .sub-link { color:var(--ink-soft); font-size:13px; }
  .player .sub-link { display:block; margin-top:1.2em; color:#d4cfc4; text-align:right; }

  .compact { margin-bottom:3em; }
  .albums { display:grid; grid-template-columns:repeat(6,1fr); gap:10px; }
  .album { position:relative; aspect-ratio:1; overflow:hidden; background:var(--tile); }
  .album:nth-child(1),.album:nth-child(6) { grid-column:span 2; grid-row:span 2; }
