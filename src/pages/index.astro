---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
const club = (await getCollection('club')).sort((a, b) => a.data.order - b.data.order);

// ① 디스코그라피 — 앨범커버. 이미지를 /public/images/discography/에 넣고 아래 배열을 채운다.
// 순서대로 표시되며, 마우스를 올리면 caption이 보인다.
const discography = [
  { src: '/images/discography/0.jpg', caption: '어쿠스틱콜라보 데뷔' },
  { src: '/images/discography/1.jpg', caption: '김필선 「마마」 — 프로듀싱, 믹싱' },
  { src: '/images/discography/2.jpg', caption: 'Choyy — 프로듀싱, 믹싱 · 유튜브 뮤직 Daily 11위' },
  { src: '/images/discography/3.jpg', caption: '이더 「낮과 밤의 틈에서 너를 생각해」 — 멜론 인디차트 Daily 1위' },
  { src: '/images/discography/4.jpg', caption: "Dean 「Howlin' 404」 — 기타 참여" },
  { src: '/images/discography/5.jpg', caption: '김필선 EP — 프로듀싱, 믹싱 · 애플뮤직 올해의 음악 100선' },
];
---
<Base>
  <!-- ① 디스코그라피 -->
  <p class="section-label">디스코그라피 <span class="label-note">(추후 작업기 업데이트 예정)</span></p>
  <div class="grid-covers">
    {discography.map((d) => (
      <div class="cover" title={d.caption}>
        <img src={d.src} alt={d.caption} loading="lazy" />
        <span class="cover-caption">{d.caption}</span>
      </div>
    ))}
  </div>

  <!-- ② 블로그 — 이미지 클릭 시 글로 이동 -->
  <p class="section-label">블로그</p>
  <div class="grid-cards">
    {posts.slice(0, 6).map((p) => (
      <a class="card" href={`/blog/${p.id}/`}>
        <div class="thumb">
          <span>대표 이미지<br />(준비 중)</span>
          {p.data.cover && <img src={p.data.cover} alt={p.data.title} onerror="this.remove()" />}
        </div>
        <h3>{p.data.title}</h3>
      </a>
    ))}
  </div>

  <!-- ③ 김승재 인증클럽 미리보기 -->
  <p class="section-label">김승재 인증클럽 — 직접 일해본 사람들</p>
  <div class="club-grid">
    {club.slice(0, 3).map((m) => (
      <a class="club-card" href={`/club/${m.id}/`}>
        <div class="cover">
          <span>{m.data.name}<br />(사진 준비 중)</span>
          {m.data.photo && <img src={m.data.photo} alt={m.data.name} onerror="this.remove()" />}
        </div>
        <div class="name">{m.data.name}</div>
        <div class="role">{m.data.role}</div>
      </a>
    ))}
  </div>
  <p><a href="/club">전체 보기 →</a></p>

  <div class="mix-line">
    16년차 믹스 엔지니어에게 곡을 맡기고 싶다면 → <a href={SITE.links.mix}>믹스 의뢰하기</a>
  </div>
</Base>
