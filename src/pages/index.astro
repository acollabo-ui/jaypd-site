  :global(:root[data-theme='dark']) .four-p .you strong,
  :global(:root[data-theme='dark']) .four-p .you span { color:#0a0b09; }
  :global(:root[data-theme='dark']) .plan.featured { background:var(--amber); color:#0a0b09; border-color:var(--amber); }
  :global(:root[data-theme='dark']) .plan.featured .type,
  :global(:root[data-theme='dark']) .plan.featured .desc,
  :global(:root[data-theme='dark']) .plan.featured .detail,
