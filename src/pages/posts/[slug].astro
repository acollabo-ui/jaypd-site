---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort((a, b) => +b.data.date - +a.data.date);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  articleSection: post.data.category,
  inLanguage: 'ko',
  author: { '@type': 'Person', name: '김승재', alternateName: 'Jay', url: `${SITE.url}/about` },
  publisher: { '@type': 'Person', name: '김승재', url: SITE.url },
  mainEntityOfPage: `${SITE.url}/posts/${post.id}/`,
};
---
<Base title={post.data.title} description={post.data.description} ogType="article" schema={articleSchema}>
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">
      {post.data.date.toISOString().slice(0, 10)} ·
      <a href={`/posts/?cat=${encodeURIComponent(post.data.category)}`}>{post.data.category}</a> ·
      {post.data.series}
    </p>
    <Content />

    <div class="mix-line">
      1:1로 믹스와 컨설팅을 맡기고 싶다면 → <a href={SITE.links.mix}>믹스 의뢰하기</a>
    </div>

    <nav class="post-nav">
      <span>{older && <a href={`/posts/${older.id}/`}>← {older.data.title}</a>}</span>
      <span>{newer && <a href={`/posts/${newer.id}/`}>{newer.data.title} →</a>}</span>
    </nav>
  </article>
</Base>
