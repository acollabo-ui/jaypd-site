---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';

const faqs = [
  {
    q: '믹싱 비용은 얼마인가요?',
    a: '곡당 50만 원 정찰제입니다. 할인은 없습니다. 대신 예산이 안 맞으면 작업 범위(트랙 수, 피드백 횟수 등)를 조정하는 방식으로 협의합니다.',
  },
  {
    q: '작업 기간은 얼마나 걸리나요?',
    a: '데모 확인 후 일정을 확정하며, 통상 착수 후 1~2주 내 1차 믹스를 전달합니다. 발매일이 정해져 있다면 의뢰 시 미리 알려주세요.',
  },
  {
    q: '피드백(수정)은 몇 번까지 가능한가요?',
    a: '기본 2회 포함입니다. 추가 수정은 범위 협의 후 진행합니다. 피드백은 구체적일수록 결과가 좋아집니다.',
  },
  {
    q: '어떤 장르를 작업하나요?',
    a: '어쿠스틱·밴드·인디·팝 계열을 가장 많이 작업했습니다. 멜론 차트인 곡부터 데뷔 싱글까지 스펙트럼이 넓습니다. 데모를 보내주시면 제가 잘할 수 있는 곡인지 먼저 말씀드립니다.',
  },
  {
    q: '의뢰할 때 무엇을 준비해야 하나요?',
    a: '트랙별 스템 파일(WAV), 레퍼런스 곡 1~2개, 데모(러프 믹스)입니다. 정리가 안 되어 있어도 괜찮습니다. 의뢰 후 안내드립니다.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="믹스 서비스"
  description="16년차 믹스 엔지니어 김승재(Jay)의 믹싱 서비스. 곡당 50만 원 정찰제. 멜론 차트인 곡들을 만든 귀로 작업합니다."
  schema={faqSchema}
>
  <h1>믹스 서비스</h1>
  <p>
    녹음이 아무리 좋아도 믹스가 무너지면 음악은 좋아지지 않습니다.
    16년 동안 아티스트·프로듀서·엔지니어로 음악 제작의 전 과정을 직접 겪은 귀로 믹스합니다.
  </p>

  <h2>비포 / 애프터</h2>
  <p><em>(준비 중 — 대표 작업 3곡의 비포/애프터를 곧 올립니다.)</em></p>
  <!-- TODO(승재): 비포애프터 음원 3곡 파일 전달 시 플레이어 교체 -->

  <h2>가격</h2>
  <p class="price">곡당 50만 원 — 정찰제</p>
  <p>
    할인은 없습니다. 대신 예산이 안 맞으면 깎는 게 아니라
    <strong>작업 범위를 조정</strong>하는 방식으로 협의합니다.
    그래야 결과물의 기준을 지킬 수 있기 때문입니다.
  </p>

  <h2>작업 프로세스</h2>
  <ol>
    <li><strong>의뢰</strong> — 신청 폼 작성 + 데모(러프 믹스) 전달</li>
    <li><strong>데모 확인</strong> — 제가 잘할 수 있는 곡인지 판단 후 일정·범위 확정</li>
    <li><strong>믹스 작업</strong> — 1차 믹스 전달 (통상 1~2주)</li>
    <li><strong>피드백</strong> — 수정 2회 포함</li>
    <li><strong>납품</strong> — 최종 WAV 전달 (마스터링 연계 가능)</li>
  </ol>

  <h2>크레딧</h2>
  <ul class="facts">
    <li>2010년 어쿠스틱콜라보 데뷔 (창립 멤버)</li>
    <li>前 소니ATV 작가 — Dean, miso, ASTRO 등 200여 곡 참여</li>
    <li>김필선(애플뮤직 올해의 음악 100선), 유다빈, 오시안(싱어게인3), 다린(싱어게인2) 외 20팀+ 프로듀싱</li>
  </ul>

  <p style="margin-top: 2.5rem;">
    <a class="btn" href={SITE.links.mixForm}>믹스 의뢰하기 (신청 폼)</a>
  </p>

  <h2>자주 묻는 질문</h2>
  <dl class="faq">
    {faqs.map((f) => (
      <>
        <dt>{f.q}</dt>
        <dd>{f.a}</dd>
      </>
    ))}
  </dl>
</Base>
