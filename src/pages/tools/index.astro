---
import Base from '../../layouts/Base.astro';

// HTML 실험물 목록 — 하나 만들 때마다 아래 배열에 한 줄씩 추가하면 된다.
// href: 사이트 안에 올렸으면 '/tools/xxx/', 밖에 있으면 전체 URL.
const tools: { name: string; desc: string; href: string; external?: boolean }[] = [];
---
<Base title="도구" description="직접 만들어 쓰는 음악 작업용 웹 도구와 실험물들.">
  <h1>도구</h1>
  <p class="meta">작업하다 필요해서 직접 만든 것들</p>

  {tools.length === 0 ? (
    <p>아직 공개한 도구가 없습니다. 하나씩 만들어 올릴 예정입니다.</p>
  ) : (
    <ul class="tool-list">
      {tools.map((t) => (
        <li>
          <a href={t.href} target={t.external ? '_blank' : null} rel={t.external ? 'noopener' : null}>
            {t.name}{t.external && ' ↗'}
          </a>
          <p>{t.desc}</p>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .tool-list { list-style: none; padding: 0; margin: 1.5em 0 0; }
  .tool-list li { padding: 0.9em 0; border-bottom: 1px solid var(--rule); }
  .tool-list a { font-size: 17px; font-weight: 600; color: var(--ink); }
  .tool-list a:hover { color: var(--amber-dark); }
  .tool-list p { margin: 0.2em 0 0; color: var(--ink-soft); font-size: 14px; }
</style>
