---
import Base from '../../layouts/Base.astro';

// HTML 실험물 목록 — 하나 만들 때마다 아래 배열에 한 줄씩 추가하면 된다.
// 파일은 public/tools/이름/index.html 로 넣고, href는 '/tools/이름/'.
// 사이트 안 것(external 없음)은 제목을 누르면 목록 아래에 펼쳐진다. 밖 것은 새 창.
const tools: { name: string; desc: string; href: string; external?: boolean }[] = [
  {
    name: '나는 음악을 직업 삼아도 될까?',
    desc: '마케팅 4P 전략으로 알아보는 아티스트 자가 진단 체크리스트',
    href: '/tools/music-career-checklist/',
  },
];
---
<Base title="장난감" description="직접 만들어 쓰는 음악 작업용 웹 도구와 실험물들.">
  <h1>장난감</h1>
  <p class="meta">작업하다 필요해서 직접 만든 것들 · 제목을 누르면 펼쳐집니다</p>

  {tools.length === 0 ? (
    <p>아직 공개한 도구가 없습니다. 하나씩 만들어 올릴 예정입니다.</p>
  ) : (
    <ul class="tool-list">
      {tools.map((t) =>
        t.external ? (
          <li>
            <a class="tool-title" href={t.href} target="_blank" rel="noopener">{t.name} ↗</a>
            <p class="tool-desc">{t.desc}</p>
          </li>
        ) : (
          <li class="tool-fold" data-src={t.href}>
            <button class="tool-toggle" type="button" aria-expanded="false">
              <span class="tool-title">{t.name}</span>
              <span class="fold-hint" aria-hidden="true">▾</span>
            </button>
            <p class="tool-desc">{t.desc}</p>
            <div class="tool-body" hidden>
              <iframe title={t.name} loading="lazy"></iframe>
              <p class="tool-standalone"><a href={t.href} target="_blank" rel="noopener">단독 페이지로 열기 ↗</a></p>
            </div>
          </li>
        )
      )}
    </ul>
  )}
</Base>

<style>
  .tool-list { list-style: none; padding: 0; margin: 1.5em 0 0; }
  .tool-list li { padding: 0.9em 0; border-bottom: 1px solid var(--rule); }
  .tool-title { font-size: 17px; font-weight: 600; color: var(--ink); }
  .tool-desc { margin: 0.2em 0 0; color: var(--ink-soft); font-size: 14px; }

  .tool-toggle {
    font: inherit; background: none; border: 0; padding: 0; cursor: pointer;
    display: flex; align-items: baseline; gap: 0.5em; width: 100%; text-align: left;
  }
  .tool-toggle:hover .tool-title { color: var(--amber-dark); }
  .fold-hint { color: var(--amber); font-size: 14px; transition: transform .2s; }
  .tool-toggle[aria-expanded='true'] .fold-hint { transform: rotate(180deg); }
  .tool-toggle[aria-expanded='true'] .tool-title { color: var(--amber-dark); }

  .tool-body { margin-top: 1em; }
  .tool-body iframe {
    display: block; width: 100%; border: 1px solid var(--rule); border-radius: 8px;
    background: #F8FAFC; /* 체크리스트 쪽 배경(slate-50)과 맞춰 로딩 중 번쩍임을 줄인다 */
    height: 600px; /* 로드 후 내용 높이에 맞게 스크립트가 늘린다 */
  }
  .tool-standalone { margin: 0.5em 0 0; font-size: 13px; text-align: right; }
</style>

<script>
  // 제목 클릭 → 아래로 펼치기. iframe은 처음 펼칠 때만 로드한다(목록만 볼 땐 공짜).
  // 같은 도메인이라 내부 문서 높이를 읽을 수 있어, 내용이 변하면(항목 펼침 등) 높이를 따라간다.
  document.querySelectorAll<HTMLLIElement>('.tool-fold').forEach((li) => {
    const toggle = li.querySelector<HTMLButtonElement>('.tool-toggle')!;
    const body = li.querySelector<HTMLDivElement>('.tool-body')!;
    const iframe = li.querySelector<HTMLIFrameElement>('iframe')!;

    const fitHeight = () => {
      const doc = iframe.contentDocument;
      if (!doc || !doc.documentElement) return;
      const h = Math.max(doc.documentElement.scrollHeight, doc.body?.scrollHeight ?? 0);
      if (h > 0) iframe.style.height = h + 'px';
    };

    // load마다 그 시점의 문서에 감시를 새로 붙인다.
    // (클릭 시점엔 아직 빈 문서(about:blank)라, 미리 붙이면 진짜 페이지를 못 본다)
    iframe.addEventListener('load', () => {
      const doc = iframe.contentDocument;
      if (!doc || !doc.documentElement) return;
      fitHeight();
      const ro = new ResizeObserver(fitHeight);
      ro.observe(doc.documentElement);
      if (doc.body) ro.observe(doc.body);
    });

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      body.hidden = open;
      if (!open && !iframe.src) iframe.src = li.dataset.src!;
    });
  });
</script>
